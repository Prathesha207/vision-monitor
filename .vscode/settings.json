{
  "python.defaultInterpreterPath": "${workspaceFolder}/vision-ai-backend/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/vision-ai-backend",
    "${workspaceFolder}/vision-ai-backend/app"
  ],
  "python.autoComplete.extraPaths": [
    "${workspaceFolder}/vision-ai-backend",
    "${workspaceFolder}/vision-ai-backend/app"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingModuleSource": "none"
  },
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true
  }
}
